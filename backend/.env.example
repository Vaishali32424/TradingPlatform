PORT=5000

# Local: mongodb://127.0.0.1:27017/trading_platform
# Atlas: mongodb+srv://USER:PASSWORD@cluster.mongodb.net/trading_platform
# Encode @ in passwords as %40 (e.g. MyPass@1 -> MyPass%401)
MONGODB_URI=mongodb://127.0.0.1:27017/trading_platform

JWT_SECRET=change-this-to-a-long-random-string

CLIENT_URL=http://localhost:5173

# Used by `npm run seed` to create the DB user (not read on login)
SUPERADMIN_LOGIN_ID=superadmin
SUPERADMIN_PASSWORD=ChangeMe123!
SUPERADMIN_NAME=Platform Admin
