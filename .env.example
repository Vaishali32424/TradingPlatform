# Copy to .env before: docker compose up -d --build

APP_PORT=80
CLIENT_URL=http://localhost

# Required — use a long random string in production
JWT_SECRET=replace-with-a-long-random-secret

# Local MongoDB (used by docker-compose.yml)
MONGO_ROOT_USER=admin
MONGO_ROOT_PASSWORD=changeme

# Optional — leave unset to use the local mongo service above
# MONGODB_URI=mongodb+srv://user:pass@cluster.mongodb.net/trading_platform

SUPERADMIN_LOGIN_ID=superadmin
SUPERADMIN_PASSWORD=ChangeMe123!
SUPERADMIN_NAME=Platform Admin
RUN_SEED=true
